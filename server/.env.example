# If set, GEMINI_API_KEYS takes precedence over GEMINI_API_KEY.
GEMINI_API_KEYS=key-one,key-two

PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_RETURN_URL=https://your-domain.com/payment/success
PAYOS_CANCEL_URL=https://your-domain.com/payment/cancel

EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=3072
LLM_MODEL=models/gemini-3.6-flash
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
SEARCH_CACHE_TTL_MS=60000
CHAT_CACHE_DISTANCE_THRESHOLD=0.08
RAG_EXPERIMENT_DELAY_MS=13000
GEMINI_REQUEST_DELAY_MS=5000
